# Environment
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Redis Caching & Session Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
SESSION_SECRET=your-session-secret-change-in-production

# MPesa Daraja API
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://your-backend-url.com/api/mpesa/callback

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Admin provisioning (production first-run). Omit ADMIN_PASSWORD to auto-generate
# a one-time password printed to the server log on first boot.
ADMIN_EMAIL=owner@omnidrive.co.ke
ADMIN_PASSWORD=change-this-strong-password

# SMS / phone OTP login. Leave SMS_PROVIDER empty in dev — codes are then printed
# to the server console and returned as `devCode` from /api/auth/otp/request.
# In production set one provider + its credentials (the app refuses to silently
# drop OTPs in production).
SMS_PROVIDER=                       # 'twilio' | 'africastalking' | (empty = simulate in dev)
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
# Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Web Push Notifications
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Error Tracking (Sentry)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Redis Cache (Optional, for Phase 2)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Database
DB_PATH=./omnidrive.db

# Security
CORS_ORIGIN=http://localhost:3000,https://omnidrive.co.ke
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# JWT authentication (REQUIRED). The app refuses to start in production without a
# strong secret (>= 32 random chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-change-me-min-32-chars
JWT_EXPIRY=8h
